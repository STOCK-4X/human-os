# --- AI coach (server only; never prefix with NEXT_PUBLIC_) -----------------
# Without this, the app works fully and shows its calculated guidance instead.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
COACH_MODEL=
# STRONGLY recommended for any public deployment: a long random string.
# Enter the same value in Profile → AI coach → Coach access token.
COACH_ACCESS_TOKEN=
# Best-effort per-instance limit (default 30)
COACH_RATE_LIMIT_PER_HOUR=

# --- Garmin (only after Garmin approves your Connect Developer Program app) --
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=

# --- Apple Health inbox (iOS Shortcut → server → app) -----------------------
# Needs COACH_ACCESS_TOKEN above (the Shortcut and the app both send it).
# Supabase project URL and service-role key: server only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64:  openssl rand -base64 32
INBOX_ENCRYPTION_KEY=
