# --- AI coach (server only; never prefix with NEXT_PUBLIC_) -----------------
# Without this, the app works fully and shows its calculated guidance instead.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
COACH_MODEL=
# STRONGLY recommended for any public deployment: a long random string.
# Enter the same value in Profile → AI coach → Coach access token.
COACH_ACCESS_TOKEN=
# Best-effort per-instance limit (default 30)
COACH_RATE_LIMIT_PER_HOUR=

# --- Garmin (only after Garmin approves your Connect Developer Program app) --
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=

# --- Supabase (phase: cloud sync; not used by the current local-first build) -
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server only, never in client code.
SUPABASE_SERVICE_ROLE_KEY=
